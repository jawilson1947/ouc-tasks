# =============================================================================
# OUC Tasks — environment variable template
# =============================================================================
# Copy this file to .env.local and fill in real values from your Supabase
# project's API settings page. .env.local is gitignored — never commit it.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Anything without that prefix is server-side only.
# =============================================================================

# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Service role key — bypasses RLS. Server-side only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Transactional email (SendGrid) ----
# Used by the Task Approval workflow to notify assignees.
# Generate the key in SendGrid → Settings → API Keys (Mail Send scope).
# The sender domain (oucsda.org) must be verified under
# SendGrid → Sender Authentication → Domain Authentication.
SENDGRID_API_KEY=SG.YOUR_KEY
EMAIL_FROM="OUC Tasks <noreply@oucsda.org>"
EMAIL_REPLY_TO=tasks-admin@oucsda.org

# ---- App config ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="OUC Infrastructure Tasks"

# ---- Time zone ----
# Single switch for app-wide date/time display.
#
#   TZ                          → sets the Node.js process timezone. Read by
#                                 Node at startup. Affects every server-side
#                                 `new Date()` and any toLocale* call that
#                                 doesn't pass an explicit timeZone option.
#                                 MUST also be set on Vercel (Project Settings
#                                 → Environment Variables) — .env files don't
#                                 ship to Vercel.
#
#   NEXT_PUBLIC_APP_TIMEZONE    → IANA zone name passed to every formatter in
#                                 src/lib/format.ts. Because NEXT_PUBLIC_*
#                                 vars are inlined at build time, the browser
#                                 also formats in this zone — visitors in
#                                 California still see Central times.
#
# To change the default zone: edit both values (use the same IANA name) and
# restart the dev server / redeploy. Common IANA names: America/Chicago (CT),
# America/New_York (ET), America/Denver (MT), America/Los_Angeles (PT), UTC.
TZ=America/Chicago
NEXT_PUBLIC_APP_TIMEZONE=America/Chicago

# ---- Supabase Storage ----
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=receipts
