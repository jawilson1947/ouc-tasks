// ============================================================================
// OUC Infrastructure Tasks — Prisma schema (MySQL)
// Mirrors supabase/migrations/mysql_schema.sql (migrations 0001–0009).
//
// Notes:
//   • UUIDs are generated by Prisma (@default(uuid())) rather than MySQL's
//     DEFAULT (UUID()) — same result, works on any MySQL 8 version.
//   • task_with_totals is a database VIEW, exposed via the "views" preview
//     feature. Prisma never migrates views — keep the CREATE VIEW statement
//     in mysql_schema.sql (or a manual migration) as the source of truth.
//   • The maybe_complete_task triggers also live only in mysql_schema.sql.
//   • MySQL has no row-level security: every access rule formerly enforced
//     by Supabase RLS must be checked in server actions / API routes.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  admin
  editor
  viewer
  approver

  @@map("user_role")
}

enum TaskStatus {
  not_started
  in_progress
  blocked
  done
  closed

  @@map("task_status")
}

enum SubtaskStatus {
  not_started
  in_progress
  done

  @@map("subtask_status")
}

enum AttachmentType {
  photo
  receipt
  spec
  document
  other

  @@map("attachment_type")
}

enum AuditAction {
  insert
  update
  delete

  @@map("audit_action")
}

// ---------------------------------------------------------------------------
// Reference tables
// ---------------------------------------------------------------------------

model Category {
  id        Int     @id @default(autoincrement())
  name      String  @unique(map: "category_name_uq") @db.VarChar(255)
  colorHex  String? @map("color_hex") @db.VarChar(20)
  sortOrder Int     @default(0) @map("sort_order")

  tasks Task[]

  @@index([sortOrder], map: "category_sort_idx")
  @@map("category")
}

model Location {
  id        Int     @id @default(autoincrement())
  name      String  @unique(map: "location_name_uq") @db.VarChar(255)
  building  String? @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")

  tasks Task[]

  @@index([sortOrder], map: "location_sort_idx")
  @@map("location")
}

// ---------------------------------------------------------------------------
// Users (replaces Supabase auth.users + user_profile)
// ---------------------------------------------------------------------------

model UserProfile {
  id String @id @default(uuid()) @db.VarChar(36)

  // Authentication fields (were managed by Supabase Auth)
  email         String  @unique(map: "user_profile_email_uq") @db.VarChar(255)
  passwordHash  String? @map("password_hash") @db.VarChar(255)
  emailVerified Boolean @default(false) @map("email_verified")

  // Password-reset flow (sha256 hex of one-time token + expiry)
  resetTokenHash    String?   @map("reset_token_hash") @db.VarChar(64)
  resetTokenExpires DateTime? @map("reset_token_expires") @db.DateTime(0)

  // Profile fields
  fullName  String    @map("full_name") @db.VarChar(255)
  role      UserRole  @default(viewer)
  phone     String?   @db.VarChar(50)
  active    Boolean   @default(true)
  lastLogin DateTime? @map("last_login") @db.DateTime(0)

  // Contractor-specific fields (NULL for non-contractor users)
  companyName      String?  @map("company_name") @db.VarChar(255)
  trade            String?  @db.VarChar(255)
  licenseNumber    String?  @map("license_number") @db.VarChar(100)
  insuranceExpiry  DateTime? @map("insurance_expiry") @db.Date
  defaultLaborRate Decimal? @map("default_labor_rate") @db.Decimal(10, 2)
  billingEmail     String?  @map("billing_email") @db.VarChar(255)
  mailingAddress   String?  @map("mailing_address") @db.Text
  notes            String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  // Relations
  contractorsCreated Contractor[] @relation("ContractorCreatedBy")
  tasksAssigned      Task[]       @relation("TaskAssignee")
  tasksCreated       Task[]       @relation("TaskCreatedBy")
  tasksApproved      Task[]       @relation("TaskApprovedBy")
  subtasksCompleted  Subtask[]    @relation("SubtaskCompletedBy")
  attachments        Attachment[] @relation("AttachmentUploadedBy")
  comments           Comment[]    @relation("CommentAuthor")
  auditEntries       AuditLog[]   @relation("AuditChangedBy")

  @@index([role, active], map: "user_profile_role_idx")
  @@map("user_profile")
}

// ---------------------------------------------------------------------------
// Contractor (vendor / sub-contractor business entity)
// ---------------------------------------------------------------------------

model Contractor {
  id               String  @id @default(uuid()) @db.VarChar(36)
  businessName     String  @map("business_name") @db.VarChar(255)
  primaryFirstName String? @map("primary_first_name") @db.VarChar(100)
  primaryLastName  String? @map("primary_last_name") @db.VarChar(100)
  primaryEmail     String? @map("primary_email") @db.VarChar(255)
  primaryPhone     String? @map("primary_phone") @db.VarChar(50)
  addressLine1     String? @map("address_line1") @db.VarChar(255)
  addressLine2     String? @map("address_line2") @db.VarChar(255)
  city             String? @db.VarChar(100)
  state            String? @db.VarChar(50)
  zipcode          String? @db.VarChar(20)
  businessPhone    String? @map("business_phone") @db.VarChar(50)
  notes            String? @db.Text
  active           Boolean @default(true)

  createdById String?      @map("created_by") @db.VarChar(36)
  createdBy   UserProfile? @relation("ContractorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, map: "fk_contractor_created_by")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  tasks Task[]

  @@index([businessName], map: "contractor_business_name_idx")
  @@index([active], map: "contractor_active_idx")
  @@map("contractor")
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id          String     @id @default(uuid()) @db.VarChar(36)
  legacyId    Int?       @unique(map: "task_legacy_id_uq") @map("legacy_id")
  title       String     @db.VarChar(500)
  description String?    @db.Text
  priority    Int // 1–5, CHECK constraint lives in the database
  status      TaskStatus @default(not_started)

  categoryId   Int?    @map("category_id")
  locationId   Int?    @map("location_id")
  assigneeId   String? @map("assignee_id") @db.VarChar(36)
  contractorId String? @map("contractor_id") @db.VarChar(36)

  dueDate     DateTime? @map("due_date") @db.Date
  needsByDate DateTime? @map("needs_by_date") @db.Date
  notes       String?   @db.Text

  createdById String?   @map("created_by") @db.VarChar(36)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  completedAt DateTime? @map("completed_at") @db.DateTime(0)

  // Approval workflow (migrations 0006 + 0008)
  approvedAt          DateTime? @map("approved_at") @db.DateTime(0)
  approvedById        String?   @map("approved_by") @db.VarChar(36)
  requestedApprovalAt DateTime? @map("requested_approval_at") @db.DateTime(0)

  category   Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "fk_task_category")
  location   Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull, map: "fk_task_location")
  assignee   UserProfile? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull, map: "fk_task_assignee")
  contractor Contractor?  @relation(fields: [contractorId], references: [id], onDelete: SetNull, map: "fk_task_contractor")
  createdBy  UserProfile? @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, map: "fk_task_created_by")
  approvedBy UserProfile? @relation("TaskApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull, map: "fk_task_approved_by")

  subtasks    Subtask[]
  attachments Attachment[]
  comments    Comment[]

  @@index([status], map: "task_status_idx")
  @@index([priority, dueDate], map: "task_priority_idx")
  @@index([assigneeId], map: "task_assignee_idx")
  @@index([categoryId], map: "task_category_idx")
  @@index([locationId], map: "task_location_idx")
  @@index([contractorId], map: "task_contractor_idx")
  @@index([approvedAt], map: "task_approved_at_idx")
  @@map("task")
}

// ---------------------------------------------------------------------------
// Subtasks
// ---------------------------------------------------------------------------

model Subtask {
  id            String        @id @default(uuid()) @db.VarChar(36)
  taskId        String        @map("task_id") @db.VarChar(36)
  sequence      Int
  description   String        @db.Text
  laborCost     Decimal       @default(0) @map("labor_cost") @db.Decimal(10, 2)
  equipmentCost Decimal       @default(0) @map("equipment_cost") @db.Decimal(10, 2)
  status        SubtaskStatus @default(not_started)
  completedAt   DateTime?     @map("completed_at") @db.DateTime(0)
  completedById String?       @map("completed_by") @db.VarChar(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade, map: "fk_subtask_task")
  completedBy UserProfile? @relation("SubtaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull, map: "fk_subtask_completed_by")

  attachments Attachment[]

  @@unique([taskId, sequence], map: "subtask_task_seq_uq")
  @@index([status], map: "subtask_status_idx")
  @@map("subtask")
}

// ---------------------------------------------------------------------------
// Attachments (photos, receipts, specs, documents)
// ---------------------------------------------------------------------------

model Attachment {
  id            String         @id @default(uuid()) @db.VarChar(36)
  taskId        String?        @map("task_id") @db.VarChar(36)
  subtaskId     String?        @map("subtask_id") @db.VarChar(36)
  type          AttachmentType @default(photo)
  filename      String         @db.VarChar(500)
  storagePath   String         @map("storage_path") @db.VarChar(1000)
  contentType   String?        @map("content_type") @db.VarChar(100)
  sizeBytes     BigInt?        @map("size_bytes")
  caption       String?        @db.Text
  receiptAmount Decimal?       @map("receipt_amount") @db.Decimal(10, 2)
  vendor        String?        @db.VarChar(255)
  receiptDate   DateTime?      @map("receipt_date") @db.Date
  uploadedById  String?        @map("uploaded_by") @db.VarChar(36)
  uploadedAt    DateTime       @default(now()) @map("uploaded_at") @db.DateTime(0)

  task       Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade, map: "fk_attachment_task")
  subtask    Subtask?     @relation(fields: [subtaskId], references: [id], onDelete: Cascade, map: "fk_attachment_subtask")
  uploadedBy UserProfile? @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull, map: "fk_attachment_uploaded")

  @@index([taskId], map: "attachment_task_idx")
  @@index([subtaskId], map: "attachment_subtask_idx")
  @@index([type], map: "attachment_type_idx")
  @@map("attachment")
}

// ---------------------------------------------------------------------------
// Comments
// ---------------------------------------------------------------------------

model Comment {
  id        String    @id @default(uuid()) @db.VarChar(36)
  taskId    String    @map("task_id") @db.VarChar(36)
  authorId  String    @map("author_id") @db.VarChar(36)
  body      String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  editedAt  DateTime? @map("edited_at") @db.DateTime(0)

  task   Task        @relation(fields: [taskId], references: [id], onDelete: Cascade, map: "fk_comment_task")
  author UserProfile @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade, map: "fk_comment_author")

  @@index([taskId, createdAt], map: "comment_task_idx")
  @@map("comment")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id          BigInt      @id @default(autoincrement())
  tableName   String      @map("table_name") @db.VarChar(100)
  recordId    String      @map("record_id") @db.VarChar(36)
  action      AuditAction
  changedById String?     @map("changed_by") @db.VarChar(36)
  changedAt   DateTime    @default(now()) @map("changed_at") @db.DateTime(0)
  oldValues   Json?       @map("old_values")
  newValues   Json?       @map("new_values")

  changedBy UserProfile? @relation("AuditChangedBy", fields: [changedById], references: [id], onDelete: SetNull, map: "fk_audit_log_changed_by")

  @@index([tableName, recordId, changedAt], map: "audit_log_record_idx")
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// task_with_totals — database VIEW (read-only).
// Managed manually in SQL (see mysql_schema.sql Section 6); Prisma only maps it.
// ---------------------------------------------------------------------------

view TaskWithTotals {
  id          String     @unique @db.VarChar(36)
  legacyId    Int?       @map("legacy_id")
  title       String     @db.VarChar(500)
  description String?    @db.Text
  priority    Int
  status      TaskStatus

  categoryId   Int?    @map("category_id")
  locationId   Int?    @map("location_id")
  assigneeId   String? @map("assignee_id") @db.VarChar(36)
  contractorId String? @map("contractor_id") @db.VarChar(36)

  dueDate     DateTime? @map("due_date") @db.Date
  needsByDate DateTime? @map("needs_by_date") @db.Date
  notes       String?   @db.Text

  createdById String?   @map("created_by") @db.VarChar(36)
  createdAt   DateTime  @map("created_at") @db.DateTime(0)
  updatedAt   DateTime  @map("updated_at") @db.DateTime(0)
  completedAt DateTime? @map("completed_at") @db.DateTime(0)

  approvedAt          DateTime? @map("approved_at") @db.DateTime(0)
  approvedById        String?   @map("approved_by") @db.VarChar(36)
  requestedApprovalAt DateTime? @map("requested_approval_at") @db.DateTime(0)

  totalLaborCost     Decimal @map("total_labor_cost") @db.Decimal(32, 2)
  totalEquipmentCost Decimal @map("total_equipment_cost") @db.Decimal(32, 2)
  totalCost          Decimal @map("total_cost") @db.Decimal(33, 2)
  subtaskCount       BigInt  @map("subtask_count")
  subtaskDoneCount   BigInt  @map("subtask_done_count")

  @@map("task_with_totals")
}
